NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://lophoc:lophoc@localhost:5433/lophoc
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Chuỗi ngẫu nhiên >= 32 ký tự. Production: `openssl rand -base64 48`
JWT_SECRET=dev-only-secret-change-me-0123456789abcdefghijklmnopqrstuvwxyz

# Google OAuth (tùy chọn; để trống thì nút Google bị ẩn)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email: dev dùng Mailpit (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Lớp Học <no-reply@lophoc.app>
MAIL_TRANSPORT=smtp
