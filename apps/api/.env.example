NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://lophoc:lophoc@localhost:5433/lophoc
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Sub-domain học sinh (CORS, Socket.IO, mã QR). Prod: https://hs.<domain>
STUDENT_APP_URL=http://hs.localhost:3000

# Chuỗi ngẫu nhiên >= 32 ký tự. Production: `openssl rand -base64 48`
JWT_SECRET=dev-only-secret-change-me-0123456789abcdefghijklmnopqrstuvwxyz

# Google OAuth (tùy chọn; để trống thì nút Google bị ẩn)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook Login (tùy chọn; để trống thì nút Facebook bị ẩn). Redirect: API_URL/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Email: dev dùng Mailpit (http://localhost:8025)
# Email: smtp = máy chủ SMTP (Mailpit ở dev, http://localhost:8025) | resend = API Resend (production) | memory = test
MAIL_TRANSPORT=smtp
MAIL_FROM=Lớp Học <no-reply@lophoc.app>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Resend: tạo API key tại https://resend.com/api-keys (quyền Sending access); tên miền trong MAIL_FROM
# phải được xác thực tại https://resend.com/domains (SPF/DKIM). Chưa có tên miền thì dùng
# MAIL_FROM=Lớp Học <onboarding@resend.dev> (chỉ gửi được tới email đăng ký Resend).
RESEND_API_KEY=

# Lưu file (ảnh câu hỏi, avatar) trên DigitalOcean Spaces. Khóa tạo tại
# https://cloud.digitalocean.com/account/api/spaces (Access Key ID 20 ký tự + Secret 43 ký tự).
# Chưa có khóa thì để STORAGE_DRIVER=memory: file giữ trong RAM, mất khi khởi động lại.
# Kiểm tra kết nối: pnpm --filter @lophoc/api storage:check
STORAGE_DRIVER=memory
SPACES_REGION=sgp1
SPACES_BUCKET=lophoc
SPACES_KEY=
SPACES_SECRET=
# Tách file dev và prod trong cùng một Space
SPACES_PREFIX=dev
# Chỉ đặt khi bật CDN hoặc dùng tên miền riêng; mặc định https://<space>.<vùng>.digitaloceanspaces.com
# SPACES_PUBLIC_URL=
# SPACES_ENDPOINT=

# AI trích xuất câu hỏi từ ảnh/PDF: claude | openai | mock (mock = không gọi mạng, dùng khi chưa có key)
# claude | openai | gemini | mock | cascade (Gemini Flash đọc cả đề, trang lỗi đưa sang Claude Sonnet)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Cascade: nhà cung cấp chính/leo thang và tỷ lệ trang tối đa được leo thang (0–1)
AI_PRIMARY_PROVIDER=gemini
AI_ESCALATION_PROVIDER=claude
AI_ESCALATION_MODEL=
AI_ESCALATION_MAX_SHARE=1
# Mức suy nghĩ Gemini 3.x khi trích xuất: LOW | MEDIUM | HIGH (gemini-3.7-flash không nhận MINIMAL)
AI_GEMINI_THINKING=LOW
# Model tùy chọn: mặc định claude-opus-5 (Claude) hoặc gpt-5.6 (OpenAI). Ví dụ rẻ hơn: claude-sonnet-5
AI_MODEL=
AI_EFFORT=medium

# Hàng đợi job nền: bullmq (cần Redis) | inline
QUEUE_DRIVER=bullmq
WORKER_INLINE=true
# Socket.IO adapter: redis (nhiều instance) | memory (một instance, test)
REALTIME_ADAPTER=redis

# Email admin nhận yêu cầu thanh toán (kèm link duyệt kích hoạt gói)
BILLING_ADMIN_EMAIL=hoquanghai.bka@gmail.com
