NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://lophoc:lophoc@localhost:5433/lophoc
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Chuỗi ngẫu nhiên >= 32 ký tự. Production: `openssl rand -base64 48`
JWT_SECRET=dev-only-secret-change-me-0123456789abcdefghijklmnopqrstuvwxyz

# Google OAuth (tùy chọn; để trống thì nút Google bị ẩn)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook Login (tùy chọn; để trống thì nút Facebook bị ẩn). Redirect: API_URL/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Email: dev dùng Mailpit (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Lớp Học <no-reply@lophoc.app>
MAIL_TRANSPORT=smtp

# Object storage: dev dùng MinIO (console http://localhost:9001); prod dùng Cloudflare R2
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=lophoc
S3_ACCESS_KEY=lophoc
S3_SECRET_KEY=lophoc123
S3_PUBLIC_URL=http://localhost:9000/lophoc
S3_FORCE_PATH_STYLE=true

# AI trích xuất câu hỏi từ ảnh/PDF: claude | openai | mock (mock = không gọi mạng, dùng khi chưa có key)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model tùy chọn: mặc định claude-opus-5 (Claude) hoặc gpt-5.6 (OpenAI). Ví dụ rẻ hơn: claude-sonnet-5
AI_MODEL=
AI_EFFORT=medium

# Hàng đợi job nền: bullmq (cần Redis) | inline
QUEUE_DRIVER=bullmq
WORKER_INLINE=true
# Socket.IO adapter: redis (nhiều instance) | memory (một instance, test)
REALTIME_ADAPTER=redis
